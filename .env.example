# Copy to .env and fill in. Never commit .env.
# Airwallex sandbox: Account > Developer > API keys (https://www.sandbox.airwallex.com)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Optional
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_API_VERSION=2026-08-21

# Claude API (hackathon credits)
ANTHROPIC_API_KEY=

# Optional locally; required on Vercel. scripts/vercel-env.sh creates both if missing
# DEMO_TOKEN=      # the app sends it as Authorization: Bearer (goes into app builds)
# ADMIN_TOKEN=     # the only token that can reset the demo; never in a build
# ANTHROPIC_MODEL= # default claude-haiku-5-5
# AIRWALLEX_GLOBAL_ACCOUNT_ID=  # npm run smoke creates one when unset
